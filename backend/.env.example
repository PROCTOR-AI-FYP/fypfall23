# Local development defaults. In production, set every variable in Railway's
# dashboard (Service -> Variables); never commit real values.
# Keep comments on their own lines: an inline comment after an empty value
# is read as the value.

# "production" enables the startup security checks.
APP_ENV=development

# --- Supabase ---
# The app connects as the non-owner app_user role so RLS on `cases` applies.
# On Supabase use the Session pooler string (IPv4) with user app_user.<project-ref>.
# With the Transaction pooler (port 6543) set DB_STATEMENT_CACHE_SIZE=0.
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/proctorai
# Owner connection, only for applying db/schema.sql and db/seed.sql. Not needed on Railway.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/proctorai
DB_STATEMENT_CACHE_SIZE=100
# https://<project-ref>.supabase.co
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SNAPSHOT_BUCKET=snapshots
SUPABASE_CLIP_BUCKET=evidence-clips
# Snapshot + record image of a dismissed case are deleted after this many days.
SNAPSHOT_RETENTION_DAYS=30

# --- Evidence clips ---
# A clip is deleted (its record JPEG kept) once the review is final:
# dismissed for CLIP_GRACE_HOURS_AFTER_DISMISSAL, or penalty issued and APPEAL_WINDOW_DAYS passed.
CLIP_GRACE_HOURS_AFTER_DISMISSAL=24
APPEAL_WINDOW_DAYS=14
CLIP_MAX_UPLOAD_BYTES=52428800
CLIP_MAX_SECONDS=30
CLIP_MAX_WIDTH=640
CLIP_FPS=10
CLIP_CRF=30
# Lifetime of the signed URLs reviewers get for clips and images.
MEDIA_URL_TTL_SECONDS=300

# --- Upstash Redis ---
# Production: rediss://default:<password>@<host>:6379 (TLS included) and REQUIRE_REDIS_TLS=true.
REDIS_URL=redis://localhost:6379/0
REQUIRE_REDIS_TLS=false

# --- HiveMQ Cloud ---
MQTT_ENABLED=false
# <cluster-id>.s1.<region>.hivemq.cloud
MQTT_HOST=
MQTT_PORT=8883
MQTT_USE_TLS=true
MQTT_USERNAME=proctorai_backend
MQTT_PASSWORD=

# --- Secrets ---
JWT_SECRET=change-this-to-a-long-random-value
# Shared with the detection worker; at least 32 characters in production.
INTERNAL_API_KEY=
# Unset -> penalty notices are rendered from templates/penalty_notice.txt.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Used when EMAIL_BACKEND=smtp.
GMAIL_APP_PASSWORD=

# --- HTTP edge ---
ALLOWED_EMAIL_DOMAIN=students.au.edu.pk
# Production Vercel URL (used in verification email links).
FRONTEND_URL=http://localhost:5173
# Comma-separated exact origins, no wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 1 on Railway (one proxy appends to X-Forwarded-For); 0 locally.
TRUSTED_PROXY_HOPS=0

# --- Email ---
# console | smtp
EMAIL_BACKEND=console
SMTP_USERNAME=
SMTP_FROM_ADDRESS=no-reply@proctorai.local
