# Frontend configuration (Vite). Copy to .env.local for development; in
# production set these in Vercel -> Project -> Settings -> Environment Variables.
# Everything here is compiled into the public JS bundle: never put a secret
# (and never the Supabase service_role key) in a VITE_ variable.

# Backend base URL, no trailing slash.
#   Development: http://localhost:8000
#   Production:  https://<service>.up.railway.app  (or leave EMPTY when Vercel
#                rewrites /api and /socket.io to the backend, so the session
#                cookie is first-party; see README "Deploying the frontend")
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and its public anon (or publishable) key, from
# Supabase -> Project Settings -> API. Used only for the Google sign-in redirect.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Passed to Google as the `hd` hint so the account picker shows university
# accounts. Use the parent domain to match both @au.edu.pk and
# @students.au.edu.pk. The backend enforces the exact domain list itself.
VITE_ALLOWED_EMAIL_DOMAIN=au.edu.pk
