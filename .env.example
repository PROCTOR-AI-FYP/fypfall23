# Frontend configuration (Vite). Copy to .env.local for development; in
# production set these in Vercel -> Project -> Settings -> Environment Variables.
# Everything here is compiled into the public JS bundle: never put a secret
# (and never the Supabase service_role key) in a VITE_ variable.

# Backend base URL, no trailing slash.
#   Development: leave EMPTY; Vite proxies /api and /socket.io to the local API.
#                This works with both localhost:5173 and 127.0.0.1:5173.
#                For another local API port, set PROCTORAI_API_PROXY_TARGET.
#   Vercel: leave EMPTY. vercel.mjs routes /api and /socket.io to the hosted
#           backend, keeping the session cookie first-party.
VITE_API_BASE_URL=
# Vercel Production/Preview only. This is a public origin, not an API key.
# Set in the Vercel dashboard; local development does not need it.
# PROCTORAI_BACKEND_URL=https://<service>.up.railway.app
# Optional development-only backend override:
# PROCTORAI_API_PROXY_TARGET=http://127.0.0.1:8000

# Supabase project URL and its public anon (or publishable) key, from
# Supabase -> Project Settings -> API. Used only for the Google sign-in redirect.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Legacy frontend setting. The backend enforces institutional email domains;
# Google sign-in no longer sends an hd hint that excludes student subdomains.
VITE_ALLOWED_EMAIL_DOMAIN=au.edu.pk
